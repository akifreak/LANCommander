# Default: normalize line endings in the index to LF on check-in
* text=auto eol=lf

# Shell scripts must always use LF (never CRLF) – critical for Linux/Docker
*.sh text eol=lf

# Windows-only scripts may use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files – do not touch line endings
*.png binary
*.jpg binary
*.ico binary
*.gif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.dll binary
*.exe binary
*.zip binary
*.gz binary
*.br binary
